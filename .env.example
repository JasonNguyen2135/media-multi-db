# ============================================================
# .env.example — Template biến môi trường Production
# Copy file này thành .env rồi điền giá trị thật vào
# KHÔNG commit file .env lên Git!
# ============================================================

# ---- Docker Registry ----
REGISTRY=your-dockerhub-username
TAG=latest

# ---- Backend: CMC Cloud DBaaS connection strings ----
# MySQL (Auth DB - lưu user accounts)
MYSQL_URL=mysql+pymysql://DB_USER:DB_PASS@CMC_MYSQL_HOST:3306/auth_db

# PostgreSQL (Articles DB - lưu bài viết, tìm kiếm full-text)
POSTGRES_URL=postgresql://DB_USER:DB_PASS@CMC_POSTGRES_HOST:5432/articles_db

# MongoDB (Drafts, Logs, Images, Comments)
MONGO_URL=mongodb://DB_USER:DB_PASS@CMC_MONGO_HOST:27017

# Redis (View count cache)
REDIS_URL=redis://:REDIS_PASS@CMC_REDIS_HOST:6379/0

# ---- Frontend: Internal ELB ----
# IP của Internal ELB (nằm giữa Frontend EC và Backend EC)
# Lấy IP này từ CMC Cloud Console sau khi tạo Internal ELB
BACKEND_URL=http://10.x.x.x:8000
